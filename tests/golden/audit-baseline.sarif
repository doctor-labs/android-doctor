                "level": "warning"
              },
              "fullDescription": {
                "text": "An APK exports an activity, service or receiver with no permission"
              },
              "help": {
                "text": "Set android:exported=\"false\", or guard it with a signature-level android:permission"
              },
              "id": "apk-exported-component",
              "name": "apk-exported-component",
              "shortDescription": {
                "text": "An APK exports an activity, service or receiver with no permission"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "An APK exports a content provider with no permission"
              },
              "help": {
                "text": "Set android:exported=\"false\", or require a signature-level permission (or separate read and write permissions)"
              },
              "id": "apk-exported-provider",
              "name": "apk-exported-provider",
              "shortDescription": {
                "text": "An APK exports a content provider with no permission"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "An APK exports a component behind a permission it declares as normal or dangerous"
              },
              "help": {
                "text": "Declare the guarding permission with android:protectionLevel=\"signature\" so only apps signed with the same key can hold it"
              },
              "id": "apk-exported-weak-permission",
              "name": "apk-exported-weak-permission",
              "shortDescription": {
                "text": "An APK exports a component behind a permission it declares as normal or dangerous"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "High intent-filter priority"
              },
              "help": {
                "text": "Keep intent-filter priorities at or below 100 unless the app must pre-empt the default handler"
              },
              "id": "apk-intent-priority-high",
              "name": "apk-intent-priority-high",
              "shortDescription": {
                "text": "High intent-filter priority"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "An APK activity uses launchMode singleTask or singleInstance"
              },
              "help": {
                "text": "Use the standard launch mode or set taskAffinity=\"\""
              },
              "id": "apk-launch-mode-singletask",
              "name": "apk-launch-mode-singletask",
              "shortDescription": {
                "text": "An APK activity uses launchMode singleTask or singleInstance"
              }
            },
            {
              "defaultConfiguration": {
                "level": "note"
              },
              "fullDescription": {
                "text": "Old minimum SDK"
              },
              "help": {
                "text": "Raise minSdkVersion to a release that still gets security updates"
              },
              "id": "apk-min-sdk-old",
              "name": "apk-min-sdk-old",
              "shortDescription": {
                "text": "Old minimum SDK"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "An APK's network-security-config permits cleartext (HTTP) traffic for a domain or globally"
              },
              "help": {
                "text": "Set cleartextTrafficPermitted to false, or scope exceptions to specific non-sensitive domains over HTTPS"
              },
              "id": "apk-nsc-cleartext",
              "name": "apk-nsc-cleartext",
              "shortDescription": {
                "text": "An APK's network-security-config permits cleartext (HTTP) traffic for a domain or globally"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "An APK's network-security-config has no <pin-set>: no certificate pinning"
              },
              "help": {
                "text": "Add a <pin-set> with at least one SHA-256 pin, or document that the app trusts the full CA store"
              },
              "id": "apk-nsc-no-pinning",
              "name": "apk-nsc-no-pinning",
              "shortDescription": {
                "text": "An APK's network-security-config has no <pin-set>: no certificate pinning"
              }
            },
            {
              "defaultConfiguration": {
                "level": "note"
              },
              "fullDescription": {
                "text": "An APK is packed or protected by a known packer"
              },
              "help": {
                "text": "Unpack the APK (run it and dump the decrypted dex) before trusting code findings; a packer is not a vulnerability by itself"
              },
              "id": "apk-packer",
              "name": "apk-packer",
              "shortDescription": {
                "text": "An APK is packed or protected by a known packer"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "A provider grants or guards every path via <grant-uri-permission> or <path-permission>"
              },
              "help": {
                "text": "Scope <grant-uri-permission>/<path-permission> to the paths that must be shared"
              },
              "id": "apk-provider-broad-path",
              "name": "apk-provider-broad-path",
              "shortDescription": {
                "text": "A provider grants or guards every path via <grant-uri-permission> or <path-permission>"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "A provider sets android:grantUriPermissions"
              },
              "help": {
                "text": "Grant per-URI with narrow <grant-uri-permission> paths instead of grantUriPermissions=\"true\""
              },
              "id": "apk-provider-grant-uri",
              "name": "apk-provider-grant-uri",
              "shortDescription": {
                "text": "A provider sets android:grantUriPermissions"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "An APK uses android:sharedUserId"
              },
              "help": {
                "text": "Drop sharedUserId (deprecated since API 29) unless the apps are meant to share a uid"
              },
              "id": "apk-shared-user-id",
              "name": "apk-shared-user-id",
              "shortDescription": {
                "text": "An APK uses android:sharedUserId"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "An APK signature does not verify (digest or signature mismatch)"
              },
              "help": {
                "text": "Re-sign the APK; a mismatch means it changed after it was signed or the signature is forged"
              },
              "id": "apk-signature-invalid",
              "name": "apk-signature-invalid",
              "shortDescription": {
                "text": "An APK signature does not verify (digest or signature mismatch)"
              }
            },
            {
              "defaultConfiguration": {
                "level": "note"
              },
              "fullDescription": {
                "text": "An APK signature could not be verified (unsupported algorithm or curve)"
              },
              "help": {
                "text": "Check the signature with apksigner verify"
              },
              "id": "apk-signature-unverified",
              "name": "apk-signature-unverified",
              "shortDescription": {
                "text": "An APK signature could not be verified (unsupported algorithm or curve)"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "Binary SMS port receiver"
              },
              "help": {
                "text": "Validate binary SMS payloads and their sender; prefer a server push channel"
              },
              "id": "apk-sms-port-receiver",
              "name": "apk-sms-port-receiver",
              "shortDescription": {
                "text": "Binary SMS port receiver"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "An APK activity sets a custom taskAffinity"
              },
              "help": {
                "text": "Set taskAffinity=\"\" unless the task sharing is intended"
              },
              "id": "apk-task-affinity",
              "name": "apk-task-affinity",
              "shortDescription": {
                "text": "An APK activity sets a custom taskAffinity"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "An APK activity or application sets allowTaskReparenting"
              },
              "help": {
                "text": "Remove allowTaskReparenting"
              },
              "id": "apk-task-reparenting",
              "name": "apk-task-reparenting",
              "shortDescription": {
                "text": "An APK activity or application sets allowTaskReparenting"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "An APK is marked android:testOnly"
              },
              "help": {
                "text": "Build the shipped APK without android:testOnly"
              },
              "id": "apk-test-only",
              "name": "apk-test-only",
              "shortDescription": {
                "text": "An APK is marked android:testOnly"
              }
            },
            {
              "defaultConfiguration": {
                "level": "note"
              },
              "fullDescription": {
                "text": "Third-party tracker or analytics SDKs are present in an APK's code"
              },
              "help": {
                "text": "Review what each SDK collects, disclose it in the privacy policy and remove the ones you do not need"
              },
              "id": "apk-tracker-sdk",
              "name": "apk-tracker-sdk",
              "shortDescription": {
                "text": "Third-party tracker or analytics SDKs are present in an APK's code"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "An APK is signed with signature scheme v1 only"
              },
              "help": {
                "text": "Re-sign with APK Signature Scheme v2 or v3"
              },
              "id": "apk-v1-only-signing",
              "name": "apk-v1-only-signing",
              "shortDescription": {
                "text": "An APK is signed with signature scheme v1 only"
              }
            },
            {
              "defaultConfiguration": {
                "level": "note"
              },
              "fullDescription": {
                "text": "Android Verified Boot signature status"
              },
              "help": {
                "text": "Sign the vbmeta image with a trusted key, or point doctor at a directory holding vbmeta.img"
              },
              "id": "avb_signature",
              "name": "avb_signature",
              "shortDescription": {
                "text": "Android Verified Boot signature status"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "A cloud access key is embedded in the image"
              },
              "help": {
                "text": "Remove the credential from the image and revoke it"
              },
              "id": "cloud_credentials",
              "name": "cloud_credentials",
              "shortDescription": {
                "text": "A cloud access key is embedded in the image"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "Build type is userdebug or eng"
              },
              "help": {
                "text": "Ship a build with ro.build.type=user"
              },
              "id": "debug-build-type",
              "name": "debug-build-type",
              "shortDescription": {
                "text": "Build type is userdebug or eng"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "A debug endpoint is referenced in the image"
              },
              "help": {
                "text": "Remove the debug hook from production firmware"
              },
              "id": "debug_endpoints",
              "name": "debug_endpoints",
              "shortDescription": {
                "text": "A debug endpoint is referenced in the image"
              }
            },
            {
              "defaultConfiguration": {
                "level": "note"
              },
              "fullDescription": {
                "text": "A test or leftover artefact ships in the image"
              },
              "help": {
                "text": "Remove the file from the production image"
              },
              "id": "debug_leftovers",
              "name": "debug_leftovers",
              "shortDescription": {
                "text": "A test or leftover artefact ships in the image"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "Build is debuggable: adbd runs as root"
              },
              "help": {
                "text": "Ship a user build with ro.debuggable=0"
              },
              "id": "debuggable-build",
              "name": "debuggable-build",
              "shortDescription": {
                "text": "Build is debuggable: adbd runs as root"
              }
            },
            {
              "defaultConfiguration": {
                "level": "note"
              },
              "fullDescription": {
                "text": "diff-avb-descriptor"
              },
              "id": "diff-avb-descriptor",
              "name": "diff-avb-descriptor",
              "shortDescription": {
                "text": "diff-avb-descriptor"
              }
            },
            {
              "defaultConfiguration": {
                "level": "note"
              },
              "fullDescription": {
                "text": "diff-avb-hash-algorithm"
              },
              "id": "diff-avb-hash-algorithm",
              "name": "diff-avb-hash-algorithm",
              "shortDescription": {
                "text": "diff-avb-hash-algorithm"
              }
            },
            {
              "defaultConfiguration": {
                "level": "note"
              },
              "fullDescription": {
                "text": "diff-avb-rollback-index"
              },
              "id": "diff-avb-rollback-index",
              "name": "diff-avb-rollback-index",
              "shortDescription": {
                "text": "diff-avb-rollback-index"
              }
            },
            {
              "defaultConfiguration": {
                "level": "note"
              },
              "fullDescription": {
                "text": "diff-avb-security-state"
              },
              "id": "diff-avb-security-state",
              "name": "diff-avb-security-state",
              "shortDescription": {
                "text": "diff-avb-security-state"
              }
            },
            {
              "defaultConfiguration": {
                "level": "note"
              },
              "fullDescription": {
                "text": "diff-avb-unchecked"
              },
              "id": "diff-avb-unchecked",
              "name": "diff-avb-unchecked",
              "shortDescription": {
                "text": "diff-avb-unchecked"
              }
            },
            {
              "defaultConfiguration": {
                "level": "note"
              },
              "fullDescription": {
                "text": "diff-new-capability"
              },
              "id": "diff-new-capability",
              "name": "diff-new-capability",
              "shortDescription": {
                "text": "diff-new-capability"
              }
            },
            {
              "defaultConfiguration": {
                "level": "note"
              },
              "fullDescription": {
                "text": "diff-new-setuid"
              },
              "id": "diff-new-setuid",
              "name": "diff-new-setuid",
              "shortDescription": {
                "text": "diff-new-setuid"
              }
            },
            {
              "defaultConfiguration": {
                "level": "note"
              },
              "fullDescription": {
                "text": "diff-prop-changed"
              },
              "id": "diff-prop-changed",
              "name": "diff-prop-changed",
              "shortDescription": {
                "text": "diff-prop-changed"
              }
            },
            {
              "defaultConfiguration": {
                "level": "note"
              },
              "fullDescription": {
                "text": "diff-root-service"
              },
              "id": "diff-root-service",
              "name": "diff-root-service",
              "shortDescription": {
                "text": "diff-root-service"
              }
            },
            {
              "defaultConfiguration": {
                "level": "note"
              },
              "fullDescription": {
                "text": "diff-sepolicy-changed"
              },
              "id": "diff-sepolicy-changed",
              "name": "diff-sepolicy-changed",
              "shortDescription": {
                "text": "diff-sepolicy-changed"
              }
            },
            {
              "defaultConfiguration": {
                "level": "note"
              },
              "fullDescription": {
                "text": "A property is defined in more than one file"
              },
              "help": {
                "text": "Remove the duplicate so the effective value is unambiguous"
              },
              "id": "duplicate_properties",
              "name": "duplicate_properties",
              "shortDescription": {
                "text": "A property is defined in more than one file"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "The stack is executable (PT_GNU_STACK has X, or is missing)"
              },
              "help": {
                "text": "Link with -z noexecstack and mark assembly with .note.GNU-stack"
              },
              "id": "elf-exec-stack",
              "name": "elf-exec-stack",
              "shortDescription": {
                "text": "The stack is executable (PT_GNU_STACK has X, or is missing)"
              }
            },
            {
              "defaultConfiguration": {
                "level": "note"
              },
              "fullDescription": {
                "text": "No stack canary (__stack_chk_fail not imported; heuristic)"
              },
              "help": {
                "text": "Build with -fstack-protector-strong"
              },
              "id": "elf-no-canary",
              "name": "elf-no-canary",
              "shortDescription": {
                "text": "No stack canary (__stack_chk_fail not imported; heuristic)"
              }
            },
            {
              "defaultConfiguration": {
                "level": "note"
              },
              "fullDescription": {
                "text": "No FORTIFY_SOURCE _chk wrappers (heuristic)"
              },
              "help": {
                "text": "Build with -D_FORTIFY_SOURCE=2 at -O1 or higher"
              },
              "id": "elf-no-fortify",
              "name": "elf-no-fortify",
              "shortDescription": {
                "text": "No FORTIFY_SOURCE _chk wrappers (heuristic)"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "A native executable is not position-independent (ET_EXEC): no ASLR"
              },
              "help": {
                "text": "Build with -fPIE -pie so the loader can randomise its base"
              },
              "id": "elf-no-pie",
              "name": "elf-no-pie",
              "shortDescription": {
                "text": "A native executable is not position-independent (ET_EXEC): no ASLR"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "No RELRO: the GOT stays writable after relocation"
              },
              "help": {
                "text": "Link with -Wl,-z,relro"
              },
              "id": "elf-no-relro",
              "name": "elf-no-relro",
              "shortDescription": {
                "text": "No RELRO: the GOT stays writable after relocation"
              }
            },
            {
              "defaultConfiguration": {
                "level": "note"
              },
              "fullDescription": {
                "text": "The native binary keeps its full symbol table (.symtab): it ships unstripped"
              },
              "help": {
                "text": "Strip release binaries with llvm-strip --strip-all, or keep the symbols in a separate debug file"
              },
              "id": "elf-not-stripped",
              "name": "elf-not-stripped",
              "shortDescription": {
                "text": "The native binary keeps its full symbol table (.symtab): it ships unstripped"
              }
            },
            {
              "defaultConfiguration": {
                "level": "note"
              },
              "fullDescription": {
                "text": "Partial RELRO: RELRO is set but relocations are lazy"
              },
              "help": {
                "text": "Link with -Wl,-z,relro,-z,now for full RELRO"
              },
              "id": "elf-partial-relro",
              "name": "elf-partial-relro",
              "shortDescription": {
                "text": "Partial RELRO: RELRO is set but relocations are lazy"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "A native library has an unsafe RPATH/RUNPATH"
              },
              "help": {
                "text": "Remove RPATH/RUNPATH, or point it only at /system, /vendor, /apex or $ORIGIN"
              },
              "id": "elf-rpath-unsafe",
              "name": "elf-rpath-unsafe",
              "shortDescription": {
                "text": "A native library has an unsafe RPATH/RUNPATH"
              }
            },
            {
              "defaultConfiguration": {
                "level": "note"
              },
              "fullDescription": {
                "text": "Files carry file capabilities"
              },
              "help": {
                "text": "Review each capability grant"
              },
              "id": "file-capabilities",
              "name": "file-capabilities",
              "shortDescription": {
                "text": "Files carry file capabilities"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "/data encryption is optional"
              },
              "help": {
                "text": "Replace encryptable= with fileencryption= so /data is always encrypted"
              },
              "id": "fstab-data-encryption-optional",
              "name": "fstab-data-encryption-optional",
              "shortDescription": {
                "text": "/data encryption is optional"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "/data is not encrypted"
              },
              "help": {
                "text": "Mount /data with fileencryption= (file-based encryption)"
              },
              "id": "fstab-data-unencrypted",
              "name": "fstab-data-unencrypted",
              "shortDescription": {
                "text": "/data is not encrypted"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "A system partition is mounted without dm-verity"
              },
              "help": {
                "text": "Add avb (or verify) to the fs_mgr flags of every read-only system partition"
              },
              "id": "fstab-no-verity",
              "name": "fstab-no-verity",
              "shortDescription": {
                "text": "A system partition is mounted without dm-verity"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "A private key is embedded in the image"
              },
              "help": {
                "text": "Remove the key from the image and rotate it"
              },
              "id": "hardcoded_credentials",
              "name": "hardcoded_credentials",
              "shortDescription": {
                "text": "A private key is embedded in the image"
              }
            },
            {
              "defaultConfiguration": {
                "level": "note"
              },
              "fullDescription": {
                "text": "An init service is declared more than once"
              },
              "help": {
                "text": "Keep one definition"
              },
              "id": "init_service_hygiene",
              "name": "init_service_hygiene",
              "shortDescription": {
                "text": "An init service is declared more than once"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "ro.secure=0: adbd keeps root"
              },
              "help": {
                "text": "Set ro.secure=1 in the shipped build"
              },
              "id": "insecure-adb",
              "name": "insecure-adb",
              "shortDescription": {
                "text": "ro.secure=0: adbd keeps root"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "A key or keystore file is shipped in the image"
              },
              "help": {
                "text": "Remove signing keys and keystores from the image; ship only public certificates"
              },
              "id": "keystore_files",
              "name": "keystore_files",
              "shortDescription": {
                "text": "A key or keystore file is shipped in the image"
              }
            },
            {
              "defaultConfiguration": {
                "level": "note"
              },
              "fullDescription": {
                "text": "A file has an unexpected mode"
              },
              "help": {
                "text": "chmod it to remove the write bit for others"
              },
              "id": "mode_anomalies",
              "name": "mode_anomalies",
              "shortDescription": {
                "text": "A file has an unexpected mode"
              }
            },
            {
              "defaultConfiguration": {
                "level": "note"
              },
              "fullDescription": {
                "text": "An expected partition image is missing"
              },
              "help": {
                "text": "Make sure system, vendor and boot images are all present"
              },
              "id": "partition_coverage",
              "name": "partition_coverage",
              "shortDescription": {
                "text": "An expected partition image is missing"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "A service API key or access token (GitHub, Slack, Stripe, ...) is embedded in the image"
              },
              "help": {
                "text": "Remove the token from the image and revoke it at the provider"
              },
              "id": "provider_tokens",
              "name": "provider_tokens",
              "shortDescription": {
                "text": "A service API key or access token (GitHub, Slack, Stripe, ...) is embedded in the image"
              }
            },
            {
              "defaultConfiguration": {
