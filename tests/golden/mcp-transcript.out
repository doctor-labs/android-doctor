{"id":2,"jsonrpc":"2.0","result":{"tools":[{"description":"Identify the format of a firmware file (identify --json)","inputSchema":{"properties":{"path":{"type":"string"}},"required":["path"],"type":"object"},"name":"identify"},{"description":"doctor scan --json: the doctor/1 envelope for a firmware directory","inputSchema":{"properties":{"baseline":{"description":"Previous --json envelope; marks findings new/unchanged and exits 3 on a new one","type":"string"},"fail_on":{"description":"Exit 1 (3 under baseline) at or above this severity","enum":["critical","high","medium","low","info"],"type":"string"},"path":{"type":"string"},"sarif":{"description":"Also write SARIF 2.1.0 to this file","type":"string"}},"required":["path"],"type":"object"},"name":"doctor"},{"description":"audit --json: the doctor/1 envelope for partition images","inputSchema":{"properties":{"baseline":{"description":"Previous --json envelope; marks findings new/unchanged and exits 3 on a new one","type":"string"},"fail_on":{"description":"Exit 1 (3 under baseline) at or above this severity","enum":["critical","high","medium","low","info"],"type":"string"},"path":{"type":"string"},"paths":{"description":"Image files or directories","items":{"type":"string"},"type":"array"},"sarif":{"description":"Also write SARIF 2.1.0 to this file","type":"string"}},"required":[],"type":"object"},"name":"audit"},{"description":"diff --json: the doctor/1 envelope comparing two firmware builds file by file; findings are what the new build made worse","inputSchema":{"properties":{"baseline":{"description":"Previous --json envelope; marks findings new/unchanged and exits 3 on a new one","type":"string"},"fail_on":{"description":"Exit 1 (3 under baseline) at or above this severity","enum":["critical","high","medium","low","info"],"type":"string"},"new":{"description":"New image or directory of images","type":"string"},"old":{"description":"Old image or directory of images","type":"string"},"only":{"description":"List o