he header of a boot or vendor_boot image (sections listed, never written)","inputSchema":{"properties":{"path":{"type":"string"}},"required":["path"],"type":"object"},"name":"unpack"},{"description":"tree --json: the whole tree (or a subtree, at most depth levels) of an ext2/3/4, erofs or f2fs image, without extracting it; the doctor/1 envelope, no findings","inputSchema":{"properties":{"depth":{"description":"Show at most N levels below the start path","minimum":0,"type":"integer"},"image":{"description":"Image file (ext2/3/4, erofs or f2fs)","type":"string"},"path":{"description":"Path inside the image to start from (default /)","type":"string"}},"required":["image"],"type":"object"},"name":"tree"},{"description":"find --json: search an ext2/3/4, erofs or f2fs image by name glob, SELinux label, setuid or setgid bit, extended attribute or content (read-only); files grep could not read are listed as not checked","inputSchema":{"properties":{"grep":{"description":"Text a regular file must contain (files up to 1 MiB)","type":"string"},"image":{"description":"Image file (ext2/3/4, erofs or f2fs)","type":"string"},"name":{"description":"Glob (* ?) for the file name","type":"string"},"path":{"description":"Directory to search under (default /)","type":"string"},"selinux":{"description":"Glob for the SELinux label","type":"string"},"setgid":{"type":"boolean"},"setuid":{"type":"boolean"},"xattr":{"description":"NAME (present) or NAME=GLOB (value matches)","type":"string"}},"required":["image"],"type":"object"},"name":"find"},{"description":"stat --json: the metadata of one path (type, mode, owner, size, links, mtime, link target, xattrs, SELinux label) inside an image; symlinks are not followed","inputSchema":{"properties":{"image":{"description":"Image file (ext2/3/4, erofs or f2fs)","type":"string"},"path":{"description":"Path inside the image","type":"string"}},"required":["image","path"],"type":"object"},"name":"stat"}]}}
